# Runtime mode
APP_ENV=local
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=ru

# Telegram
TELEGRAM_BOT_TOKEN=
BOT_POLLING_TIMEOUT=30

# LLM gateway
OPENROUTER_API_KEY=
OPEN_ROUTER_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openrouter/owl-alpha
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-v4-flash

# Pipeline defaults
# Internal compatibility field. The bot UI uses one unified model policy.
QUALITY_MODE=balanced
IDEAS_COUNT=30
SCRIPTS_COUNT=10
PIPELINE_TRACE_DIR=logs/pipeline_runs

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://smm:smm@localhost:5432/smm
POSTGRES_DSN=postgresql://smm:smm@localhost:5432/smm

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
