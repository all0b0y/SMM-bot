# Runtime mode
APP_ENV=local
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=ru

# Telegram
TELEGRAM_BOT_TOKEN=
BOT_POLLING_TIMEOUT=30

# LLM gateway
OPENROUTER_API_KEY=
OPEN_ROUTER_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-chat

# Pipeline defaults
QUALITY_MODE=balanced
IDEAS_COUNT=30
SCRIPTS_COUNT=10

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://smm:smm@localhost:5432/smm
POSTGRES_DSN=postgresql://smm:smm@localhost:5432/smm

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
